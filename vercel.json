{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/js/wix/:path*",
      "destination": "https://headless-llqqoewftei-truvisiondesign-140f.wix-site-host.com/js/wix/:path*"
    }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
